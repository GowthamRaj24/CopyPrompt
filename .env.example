# ─── Database (Supabase) ────────────────────────────────────────────
# Get from Supabase Dashboard -> Settings -> Database -> Connection String -> URI
#
# IMPORTANT — use the POOLER URL, not the direct URL:
#   ● Session mode (port 5432, ".pooler.supabase.com") — recommended default.
#     Behaves like a direct connection, supports prepared statements,
#     and lets you safely run DB_POOL_SIZE up to ~15 on the free tier.
#   ● Transaction mode (port 6543, ".pooler.supabase.com") — use this when
#     scaling horizontally (multiple Next.js instances). Multiplexes
#     aggressively; DB_POOL_SIZE 25-50 per instance is fine.
#   ● Direct (db.<ref>.supabase.co:5432) — only for migrations / one-off
#     scripts. Burns connections quickly under app traffic.
DATABASE_URL=postgresql://postgres.your_ref:your_password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Get from Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your_ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxx

# ─── Cloudflare R2 (S3-compatible) ──────────────────────────────────
# Get from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=copyprompt-images
R2_PUBLIC_URL=https://your_bucket.r2.dev

# ─── Together AI (Flux images + semantic search embeddings) ─────────
# Get from https://api.together.xyz -> Settings -> API Keys
# Powers BAAI/bge-base-en-v1.5 (768-dim) for /search relevance + similar prompts.
TOGETHER_API_KEY=

# ─── Hugging Face (free embeddings) ─────────────────────────────────
# Only needed if TOGETHER_API_KEY is unset. Must be a fine-grained token with
# "Make calls to Inference Providers" enabled (read-only classic tokens get 403):
# https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
HF_TOKEN=

# ─── Jina AI (easiest free embedding fallback) ──────────────────────
# Get a free key at https://jina.ai/?sui=apikey (768-dim, same as BGE column)
JINA_API_KEY=

# ─── SMTP (Nodemailer) for sending OTPs ─────────────────────────────
# For Gmail: smtp.gmail.com on port 465. Need 2FA enabled + App Password.
# Generate at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=mycopyprompt

# ─── Razorpay (later, for premium) ──────────────────────────────────
# Get from https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Cron secret (for /api/cron/* protection) ───────────────────────
# Generate with: openssl rand -hex 32  (or any random string)
CRON_SECRET=

# ─── App ────────────────────────────────────────────────────────────
# Production: https://mycopyprompt.in
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── DB tuning (optional) ───────────────────────────────────────────
# Postgres connection pool size per Next.js instance. Default 10 is
# safe on Supabase free tier (60 total). With the transaction-mode
# pooler (port 6543) you can safely raise this to 25-50.
DB_POOL_SIZE=10
# Set DB_LOG=1 to echo every Drizzle SQL query (chatty — off by default).
DB_LOG=

# ─── Cloudflare Turnstile (CAPTCHA) ─────────────────────────────────
# Free invisible bot protection for /signup and /submit. Both keys are
# required together; if either is blank, captcha is bypassed (fine for
# local dev, MUST be set in production).
# Get keys at: https://dash.cloudflare.com -> Turnstile -> Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── PostHog (optional — client-side product analytics) ─────────────
# The admin /admin/analytics dashboard works without this (it reads
# straight from Postgres). Set this only if you want PostHog session
# replay / funnels / experiments in addition to our first-party stats.
# Get the project key at: https://app.posthog.com -> Project settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Supabase Storage (free image uploads) ──────────────────────────
# Bucket name to use for prompt-image uploads. Run `npm run db:setup-storage`
# once after deploy to create the bucket idempotently. Default if unset:
# "prompt-images". Free tier ships with 1 GB storage + 2 GB egress/mo —
# plenty for tens of thousands of small screenshots.
SUPABASE_STORAGE_BUCKET=prompt-images
